{
  "name": "mouse-remapper",
  "version": "1.0.0",
  "description": "Remapeia scroll e clique do meio do mouse para teclas do teclado no macOS",
  "main": "src/main.js",
  "scripts": {
    "build-helper": "cd native && swiftc -O MouseRemapHelper.swift -o MouseRemapHelper",
    "start": "npm run build-helper && electron .",
    "dist": "npm run build-helper && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.brunnoandrade.mouseremapper",
    "productName": "Mouse Remapper",
    "icon": "build/icon.icns",
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dir",
      "icon": "build/icon.icns",
      "extraResources": [
        { "from": "native/MouseRemapHelper", "to": "MouseRemapHelper" }
      ]
    }
  }
}
