{
  "name": "mouse-remapper",
  "version": "1.0.0",
  "description": "Remapeia scroll e botões do mouse para teclas, atalhos do sistema e mais, no macOS e no Windows",
  "main": "src/main.js",
  "scripts": {
    "build-helper": "node scripts/build-helper.js",
    "start": "npm run build-helper && electron .",
    "dist": "npm run build-helper && electron-builder",
    "test": "node --test tests/*.test.js",
    "verify-package": "node scripts/verify-package.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.brunnoandrade.mouseremapper",
    "productName": "Mouse Remapper",
    "icon": "build/icon.icns",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "native/MouseRemapHelper",
          "to": "MouseRemapHelper"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "native/windows/MouseRemapHelper.exe",
          "to": "MouseRemapHelper.exe"
        }
      ]
    },
    "artifactName": "MouseRemapper-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
